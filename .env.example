NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Secret key (sb_secret_...) — server only, bypasses RLS. Do NOT use the publishable key here.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to your production URL (custom domain or *.vercel.app)
NEXT_PUBLIC_APP_NAME=Makro Intelligence

# QuickBooks Online — from developer.intuit.com → Keys & OAuth
INTUIT_CLIENT_ID=your-client-id
INTUIT_CLIENT_SECRET=your-client-secret
# Must match EXACTLY what you register in Intuit portal (Development or Production tab).
# Sandbox (local dev): http://localhost:3000/api/intuit/callback — Development tab only
# Production (real company): HTTPS required, e.g. https://your-app.vercel.app/api/intuit/callback
#   For local production testing use ngrok: ngrok http 3000 → https://xxxx.ngrok-free.app/api/intuit/callback
INTUIT_REDIRECT_URI=http://localhost:3000/api/intuit/callback
# sandbox | production — must match the keys tab you copied credentials from
INTUIT_ENVIRONMENT=sandbox
